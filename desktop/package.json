{
  "name": "seven-gestion-desktop",
  "version": "0.2.5",
  "private": true,
  "description": "Seven Hotels & Apartments — Gestion Windows",
  "main": "main.cjs",
  "author": "Seven Hotels & Apartments",
  "license": "UNLICENSED",
  "scripts": {
    "prepare:renderer": "node scripts/build.mjs",
    "start": "npm run prepare:renderer && electron .",
    "dist:win": "npm run prepare:renderer && electron-builder --win nsis --publish never",
    "check": "node --check main.cjs && node --check updates.cjs && node --check preload.cjs && node --check offline.js && node --check update-ui.js && node --check scripts/build.mjs",
    "test": "node scripts/smoke.mjs && node scripts/updater.test.cjs",
    "dist:release": "npm run prepare:renderer && electron-builder --win nsis --publish always",
    "test:layout": "electron scripts/visual-smoke.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "electron-updater": "6.8.12"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "cd.sevenhotels.gestion",
    "productName": "Seven Gestion",
    "directories": {
      "output": "../release"
    },
    "asar": true,
    "files": [
      "main.cjs",
      "updates.cjs",
      "update-ui.js",
      "preload.cjs",
      "renderer/**/*",
      "package.json",
      "assets/seven.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/seven.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Nokscoding",
        "repo": "sevenhoels",
        "releaseType": "draft"
      }
    ],
    "artifactName": "Seven-Gestion-Setup-${version}.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nokscoding/sevenhoels.git"
  }
}
